# Copy to .env and fill in. Never commit .env.
# Server-only (never prefix these with VITE_):
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public (shipped to the browser):
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public site URL, no trailing slash (links in emails, unsubscribe links, sitemap)
SITE_URL=
# Same URL, for absolute canonical links and JSON-LD in page <head> (optional; relative without it)
VITE_SITE_URL=

# Email (Resend). Without these, emails are only logged on the server.
RESEND_API_KEY=
EMAIL_FROM=
# Fallback for new-order alerts. Admin → Settings → SEO & Email → "New order alerts to"
# takes priority; without either, the store contact email is used.
STORE_ALERT_EMAIL=

# Protects /api/cron/reminders (send as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# JazzCash (not live yet: see src/lib/payments/jazzcash.server.ts)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_ENV=sandbox

# EasyPaisa (not live yet: see src/lib/payments/easypaisa.server.ts)
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_ENV=sandbox
